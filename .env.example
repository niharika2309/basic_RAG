# Copy this file to .env (in the same folder) and fill in your values:
#
#     cp .env.example .env
#
# .env is gitignored — never commit your keys.

# ── LLM: any OpenAI-compatible API (needed for step 4 / the web app) ──
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional — "reasoning" models think before answering and may need
# more tokens (default is 2000):
# LLM_MAX_TOKENS=4000

# Optional — a smaller/faster embedding model (default is all-MiniLM-L12-v2):
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional — the reranker that re-checks search results in step 3 (a second,
# more careful model that reads your question together with each candidate):
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=20    # how many search hits it re-checks, before keeping top 5
