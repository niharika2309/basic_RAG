# Copy this file to .env (in the same folder) and fill in your values:
#
#     cp .env.example .env
#
# .env is gitignored — never commit your keys.

# ── LLM: any OpenAI-compatible API ─────────────────────────────────────
# Works out of the box with a regular OpenAI account:
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Example: use Qwen3.8-27B on an OpenAI-compatible endpoint instead
# (any provider that serves it works — just change BASE_URL + MODEL):
# LLM_MODEL=Qwen3.8-27B
# LLM_BASE_URL=https://your-endpoint.example.com/v1

# ── Embedder: a local model, no key needed ─────────────────────────────
# (default, better retrieval quality):
# EMBEDDING_MODEL=all-MiniLM-L12-v2
# (smaller / faster alternative):
# EMBEDDING_MODEL=all-MiniLM-L6-v2
